server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Application monopage : toute route inconnue retombe sur index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Les assets sont nommes avec un hash de contenu : ils peuvent etre caches longtemps.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # L'amont est injecte au demarrage du conteneur (envsubst) : nom de service en local,
    # FQDN de la Container App de l'API une fois deploye.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
