# Copier vers .env et ajuster. Ne jamais committer .env.

# --- Base de donnees -------------------------------------------------------
# Depuis un conteneur Docker (SQL Server tourne sur l'hote Windows) :
ConnectionStrings__Tournoi=Server=host.docker.internal,1433;Database=Archipelago;User Id=tournoi_app;Password=CHANGE_MOI;TrustServerCertificate=True;Encrypt=True

# Depuis l'hote en dev (dotnet run), utiliser plutot :
# ConnectionStrings__Tournoi=Server=localhost;Database=Archipelago;User Id=tournoi_app;Password=CHANGE_MOI;TrustServerCertificate=True;Encrypt=True
# ou l'authentification Windows integree :
# ConnectionStrings__Tournoi=Server=localhost;Database=Archipelago;Trusted_Connection=True;TrustServerCertificate=True

# --- Panneau d'admin -------------------------------------------------------
Admin__Username=admin
Admin__Password=CHANGE_MOI

# --- Signature des jetons JWT ---------------------------------------------
# Minimum 32 caracteres. Generer avec :
#   openssl rand -base64 48
Jwt__Key=CHANGE_MOI_par_une_cle_aleatoire_de_32_caracteres_minimum
